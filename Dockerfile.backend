# Dockerfile for Backend (FastAPI + Playwright)
FROM python:3.10-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖 (核弹级换源：搜索并替换所有配置，使用 HTTP 绕过 SSL 限制)
RUN find /etc/apt/ -type f -name "*.list" -o -name "*.sources" | xargs sed -i 's/deb.debian.org/mirrors.tuna.tsinghua.edu.cn/g' && \
    find /etc/apt/ -type f -name "*.list" -o -name "*.sources" | xargs sed -i 's/security.debian.org/mirrors.tuna.tsinghua.edu.cn/g' && \
    find /etc/apt/ -type f -name "*.list" -o -name "*.sources" | xargs sed -i 's/https/http/g'

RUN apt-get update --fix-missing && apt-get install -y \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# 复制依赖文件并安装 (使用清华源加速)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt -i https://pypi.tuna.tsinghua.edu.cn/simple

# 安装 Playwright 浏览器
RUN playwright install chromium

# 复制项目所有文件
COPY . .

# 暴露后端端口
EXPOSE 8000

# 运行后端
CMD ["uvicorn", "api.server:app", "--host", "0.0.0.0", "--port", "8000"]
